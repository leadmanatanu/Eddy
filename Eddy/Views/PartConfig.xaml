<Window x:Class="Eddy.PartConfig"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Eddy"
        mc:Ignorable="d"
        Title="Window1" 
        ResizeMode="NoResize" Height="450" WindowStartupLocation="CenterScreen"  Width="720"  WindowState="Normal"  WindowStyle="None"
        >
    <Border Name="brRef" Margin="3" Background="#DBDBDB" Grid.Column="1" Grid.Row="2" BorderBrush="#DBDBDB" BorderThickness="1" CornerRadius="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.2*"/>
                <RowDefinition Height="0.04*"/>
                <RowDefinition Height="0.7*"/>
                <RowDefinition Height="0.04*"/>
                <RowDefinition Height="0.25*"/>
                <RowDefinition Height="0.5*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Margin="0,10,0,0" Content="File Configuration" VerticalAlignment="Top" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Grid.Row="0" Grid.Column="0"></Label>
            <!--<Image Name="btnClose" Margin="0,15,25,0" VerticalAlignment="Top" Width="30" MouseUp="Button_Click" HorizontalAlignment="Right" Source="/Images/Group 48.png" />-->
            <Border Width="80" Name="btnClose" Margin="0,15,25,0" MouseDown="Button_Click" Background="#305371" HorizontalAlignment="Right" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                <Label Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Close" ></Label>
            </Border>
            <Separator VerticalAlignment="Top" Grid.Row="1" Grid.Column="0"/>
            <Grid Margin="20,30,30,20" Grid.Row="2" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <!--<RowDefinition/>
                    <RowDefinition/>-->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Label Margin="20,0,0,0" Content="File Name" FontSize="16" FontWeight="Bold" Grid.Row="0" Grid.Column="0"></Label>
                <TextBox Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top" Grid.Row="0" Grid.Column="1" Name="txtBatchName" />
                

                <Label Name="lblBatchSize" Visibility="Hidden"  Content="File Size" FontSize="16" FontWeight="Bold" Grid.Row="0" Grid.Column="2"></Label>
                <TextBox Visibility="Hidden"  PreviewTextInput="PreviewTextInput_NumericOnly" Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top" Grid.Row="0" Grid.Column="3" Name="txtBatchSize" />

                
                <Label Margin="20,0,0,0" Content="Place" FontSize="16" FontWeight="Bold" Grid.Row="1" Grid.Column="0"></Label>
                <TextBox Margin="0,0,20,0" FontSize="16" VerticalAlignment="Top" Grid.Row="1" Grid.Column="1" Name="txtPlace" />

                <Label Content="Grade" FontSize="16" FontWeight="Bold" Grid.Row="1" Grid.Column="2"></Label>
                <TextBox Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top" Grid.Row="1" Grid.Column="3" Name="txtGrade" />

                <Label Margin="20,0,0,0" Content="Company Name" FontSize="16" FontWeight="Bold" Grid.Row="2" Grid.Column="0"></Label>
                <TextBox Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top" Grid.Row="2" Grid.Column="1" Name="txtCompanyName" />
                <Label Content="Checked By" FontSize="16" FontWeight="Bold" Grid.Row="2" Grid.Column="2"></Label>
                <TextBox Margin="0,0,20,0" FontSize="16"  VerticalAlignment="top" Grid.Row="2" Grid.Column="3" Name="txtCheckedBy" />

                

            </Grid>
            <Separator VerticalAlignment="Top" Grid.Row="3" Grid.Column="0"/>

            <Border Width="250" Name="btnConfigSave" MouseDown="btnConfigSave_Click" Margin="1" Background="#305371" Grid.Column="0" Grid.Row="4" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                <Label Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Start Log" ></Label>
            </Border>

            <Label Content="" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Top" Name="lblMsg" Grid.Row="5" Grid.Column="0"></Label>

        </Grid>
    </Border>
</Window>
