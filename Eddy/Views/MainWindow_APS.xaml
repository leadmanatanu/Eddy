<Window x:Class="Eddy.MainWindow_APS"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:local="clr-namespace:Eddy"
        mc:Ignorable="d"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize">
    <Grid Background="Black"  Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height=".4*"/>
            <RowDefinition Height=".1*"/>
            <RowDefinition Height="8.5*"/>
            <RowDefinition Height="0*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Background="LightGray" Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7.5*"/>
                <ColumnDefinition  Width="2.5*"/>
                <ColumnDefinition  Width="1*"/>
                <ColumnDefinition  Width="1*"/>
                <ColumnDefinition  Width="1 *"/>
            </Grid.ColumnDefinitions>
            <Menu Background="LightGray" VerticalAlignment="Center" Height="30" FontSize="18" Grid.Row="0" Grid.Column="0" DockPanel.Dock="Top" ItemsSource="{Binding MenuItems}">
                <Menu.ItemContainerStyle>
                    <Style TargetType="{x:Type MenuItem}">
                        <Setter Property="Command" Value="{Binding Command}" />
                    </Style>
                </Menu.ItemContainerStyle>
                <Menu.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type local:MenuItemViewModel_APS}" ItemsSource="{Binding Path=MenuItems}">
                        <TextBlock Text="{Binding Header}"/>
                    </HierarchicalDataTemplate>
                </Menu.ItemTemplate>
            </Menu>
            <Label Grid.Row="0" Visibility="Hidden" Grid.Column="1" Name="lblConfigFileName" />

            <Grid Grid.Row="0" Grid.Column="1" >
                <Grid Grid.Row="0" Grid.Column="0" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition  Width="5*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" FontSize="16" Name="lblTT" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" Content="Tube Test Time(S)" ></Label>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,10,20,0" FontSize="16" VerticalAlignment="Top" Name="ddlTT" SelectionChanged="ddlTT_SelectionChanged" />
                </Grid>
            </Grid>

            <Grid Grid.Row="0" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Border Cursor="Hand" Width="110" Name="btnCali" MouseDown="btnCali_MouseDown"  Background="Gray" Margin="1" Grid.Column="0" Grid.Row="0" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="5">
                    <Label Foreground="White" FontSize="20" Name="lblCali" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Auto Zero" ></Label>
                </Border>
            </Grid>

            <Grid Grid.Row="0" Grid.Column="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Border Cursor="Hand" Width="110" Name="btnCalibration" MouseDown="btnCalibration_MouseDown"  Background="Gray" Margin="1" Grid.Column="0" Grid.Row="0" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="5">
                    <Label Foreground="White" FontSize="20" Name="lblCalibration" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Balance" ></Label>
                </Border>
            </Grid>

            <Border HorizontalAlignment="Right" Width="100" Name="btnTestStatus" Margin="0" Background="Gray" Grid.Column="5" Grid.Row="0"  BorderThickness="1" CornerRadius="0">
                <Label Foreground="White" FontSize="12" Name="lblTest" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Test Off" ></Label>
            </Border>

        </Grid>

        <Grid Background="DimGray" Grid.Row="1" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

        </Grid>
        <Grid Grid.Row="2" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7.5*"/>
                <ColumnDefinition Width="2.5*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="0" Grid.Column="0" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>

                </Grid.RowDefinitions>
                <ScottPlot:WpfPlot Grid.Column="0" Margin="2" Grid.Row="0" Name="WpfPlot1" />
                <ScottPlot:WpfPlot Grid.Column="0" Margin="2" Grid.Row="1" Name="WpfPlotA1" />
                <ScottPlot:WpfPlot Grid.Column="0" Margin="2" Grid.Row="2" Name="WpfPlot4" />
                <ScottPlot:WpfPlot Grid.Column="0" Margin="2" Grid.Row="3" Name="WpfPlotA1Last" />
            </Grid>

            <Grid Grid.Column="1" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3.8*"/>
                    <RowDefinition Height="3.2*" MinHeight="150"/>
                    <RowDefinition Height="3.0*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Cursor="Hand" Width="150" Height="52" Name="btnLog" MouseDown="btnLog_MouseDown" Margin="2" Background="#305371" Grid.Column="0" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                        <Label Foreground="White" FontSize="20" Name="lblLog" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Start Log" ></Label>
                    </Border>

                    <Border Cursor="Hand" Width="150" Height="52" Name="btnClear" MouseDown="btnClear_MouseDown" Margin="2" Background="#305371" Grid.Column="1" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                        <Label Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Clear Counter" ></Label>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="2">
                    <ScottPlot:WpfPlot Name="wpCounter" />
                </Grid>

                <Border Grid.Row="2" Margin="4,2,4,4" Background="#111111" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Results" Foreground="#CCCCCC" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,4"/>
                        <TextBlock Name="txtNoResults" Grid.Row="1" Text="No recent test results" Foreground="#666666" FontSize="14" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ItemsControl Name="icLastResults" Grid.Row="1">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding BackgroundBrush}" CornerRadius="5" Margin="2,2" Padding="12,5" BorderBrush="#333333" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Label Foreground="Red" FontSize="26" Grid.Row="0" FontWeight="Bold" Name="lblResultStatus" VerticalAlignment="Center" HorizontalAlignment="Center" Content="" ></Label>

                    <Grid Grid.Row="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label Foreground="Green" FontSize="28" Grid.Row="0" FontWeight="Bold" Name="lblOk" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Ok Count-0" ></Label>
                        <Label Foreground="Red" FontSize="28" Grid.Row="1" FontWeight="Bold" Name="lblNotOk" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Not Ok Count-0" ></Label>
                        <Label Foreground="Orange" FontSize="28" Grid.Row="2" FontWeight="Bold" Name="lblTotal" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Total Count-0" >
                        </Label>
                    </Grid>

                    <Border x:Name="br1" Visibility="Hidden" Grid.Row="0" BorderThickness="0" Width="0" Height="0">
                        <Canvas  x:Name="Canvas1" HorizontalAlignment="Left" Margin="0" VerticalAlignment="Top">
                            <Rectangle Name="br1_rec1"/>
                            <Rectangle Name="br1_rec2"/>
                            <Rectangle Name="br1_rec3"/>
                            <Canvas  x:Name="Canvas2" HorizontalAlignment="Left" Margin="0" VerticalAlignment="Top"/>
                        </Canvas>
                    </Border>
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</Window>