<Window x:Class="MachineInfo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Machine Information"
        Height="430"
        Width="740"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F3F4F6"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Primary action button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1E40AF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#9CA3AF"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary (Close) button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D1D5DB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Border Margin="24"
            CornerRadius="10"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            Padding="32">

        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="2"
                              Opacity="0.08"
                              Color="Black"/>
        </Border.Effect>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="6"
                            Height="26"
                            CornerRadius="3"
                            Background="#2563EB"
                            Margin="0,0,12,0"/>
                    <TextBlock Text="Machine Information"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#111827"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Enter the instrument serial number to generate or retrieve the unique Machine ID."
                           Margin="18,6,0,0"
                           Foreground="#6B7280"
                           FontSize="13"/>
            </StackPanel>

            <!-- Serial Number Input -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="Serial Number"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="#1F2937"
                           Margin="0,0,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#FFFFFF"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBox x:Name="txtSerialNumber"
                                 Height="42"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 Padding="12,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#111827"
                                 KeyDown="TxtSerialNumber_KeyDown"/>
                    </Border>

                    <Button x:Name="btnGenerate"
                            Grid.Column="2"
                            Width="130"
                            Height="42"
                            Content="Generate"
                            Style="{StaticResource PrimaryButton}"
                            Click="BtnGenerate_Click"/>
                </Grid>
            </StackPanel>

            <!-- Machine ID Output -->
            <StackPanel Grid.Row="4">
                <TextBlock Text="Machine ID"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="#1F2937"
                           Margin="0,0,0,8"/>

                <Border Background="#F9FAFB"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="6">
                    <TextBox x:Name="txtMachineId"
                             Height="44"
                             FontSize="12"
                             FontFamily="Consolas"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             Padding="12,0"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#111827"/>
                </Border>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button x:Name="btnCopy"
                        Width="130"
                        Height="40"
                        Margin="0,0,12,0"
                        Content="Copy"
                        IsEnabled="False"
                        Style="{StaticResource PrimaryButton}"
                        Click="BtnCopy_Click"/>

                <Button x:Name="btnClose"
                        Width="110"
                        Height="40"
                        Content="Close"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnClose_Click"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>
