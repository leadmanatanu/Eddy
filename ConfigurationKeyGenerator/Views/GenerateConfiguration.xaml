<Window x:Class="ConfigurationKeyGenerator.Views.AddLicense"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="750"
        Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F9FAFB">


    <Window.Resources>


        <!-- Label Style -->
        <Style x:Key="FieldLabel"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#111827"/>

            <Setter Property="Margin"
                    Value="0,0,0,6"/>

        </Style>



        <!-- Input Style -->
        <Style x:Key="InputBox"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Padding"
                    Value="8"/>

            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

        </Style>



        <!-- Button -->
        <Style x:Key="PrimaryButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#2563EB"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="Width"
                    Value="150"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>


        </Style>


    </Window.Resources>



    <Grid Margin="30">


        <Border Background="White"
                CornerRadius="10"
                Padding="35">


            <Border.Effect>

                <DropShadowEffect BlurRadius="20"
                                  Opacity="0.15"/>

            </Border.Effect>



            <StackPanel>



                <TextBlock Text="Generate Configuration"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>


                <TextBlock Text="Create encrypted configuration file"
                           Foreground="Gray"
                           Margin="0,5,0,25"/>




                <!-- Product -->

                <TextBlock Text="Product"
                           Style="{StaticResource FieldLabel}"/>


                <ComboBox x:Name="cmbProduct"
                          Height="38"
                          SelectedIndex="0">

                    <ComboBoxItem>
                        EddyShorter
                    </ComboBoxItem>

                    <ComboBoxItem>
                        EddyTube
                    </ComboBoxItem>

                    <ComboBoxItem>
                        EddyFaster
                    </ComboBoxItem>

                </ComboBox>




                <!-- Customer -->

                <TextBlock Text="Customer Name"
                           Style="{StaticResource FieldLabel}"
                           Margin="0,20,0,6"/>


                <TextBox x:Name="txtCustomerName"
                         Style="{StaticResource InputBox}"/>




                <!-- Machine ID -->

                <TextBlock Text="Machine ID"
                           Style="{StaticResource FieldLabel}"
                           Margin="0,20,0,6"/>


                <TextBox x:Name="txtMachineId"
                         Style="{StaticResource InputBox}"/>




                <!-- Config File -->

                <TextBlock Text="Configuration File"
                           Style="{StaticResource FieldLabel}"
                           Margin="0,20,0,6"/>


                <Grid>


                    <Grid.ColumnDefinitions>

                        <ColumnDefinition/>

                        <ColumnDefinition Width="120"/>

                    </Grid.ColumnDefinitions>



                    <TextBox x:Name="txtConfigFile"
                             Style="{StaticResource InputBox}"
                             IsReadOnly="True"/>


                    <Button Grid.Column="1"
                            Content="Browse"
                            Margin="10,0,0,0"
                            Click="BtnBrowse_Click"/>


                </Grid>




                <!-- Buttons -->


                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,40,0,0">


                    <Button Content="Cancel"
                            Width="120"
                            Height="40"
                            Margin="0,0,10,0"
                            Click="BtnCancel_Click"/>



                    <Button Content="Generate Key"
                            Style="{StaticResource PrimaryButton}"
                            Click="BtnSave_Click"/>


                </StackPanel>



            </StackPanel>


        </Border>


    </Grid>


</Window>