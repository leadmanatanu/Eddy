<UserControl x:Class="_8F.Views.ChannelPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="600"
             Background="Black"
             MouseDown="OnPanelMouseDown">
    <Grid Margin="2">
        <Grid.RowDefinitions>
            <!-- Row 0: Channel Header (Maximize / Restore / Active Indicator) -->
            <RowDefinition Height="36"/>
            <!-- Row 1: 8 Plot cells (4x2 responsive centered block) -->
            <RowDefinition Height="*"/>
            <!-- Row 2: Bottom Control Bar (Buttons, Counts, Overall Result) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- HEADER -->
        <!-- ======================================================== -->
        <Border Grid.Row="0" Margin="2,1,2,3" Background="{Binding HeaderBrush}" CornerRadius="6"
                BorderBrush="#222222" BorderThickness="1" MouseDown="OnHeaderMouseDown">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Channel Name -->
                <Label Grid.Column="0" Content="{Binding ChannelName}" Foreground="White"
                       FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>

                <!-- Hidden Sibling Status Chip (Only visible when this panel is maximized) -->
                <Border x:Name="chipHiddenStatus" Grid.Column="2" Margin="0,0,8,0" Padding="8,2"
                        Background="{Binding HiddenChannelBrush}" CornerRadius="4"
                        VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="{Binding HiddenChannelText}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                </Border>

                <!-- Maximize / Restore Button -->
                <Button Grid.Column="3" Width="30" Height="28" Margin="2"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        ToolTip="{Binding MaximizeToolTip}" Click="OnMaximizeClick">
                    <TextBlock Text="{Binding MaximizeIcon}" FontFamily="Segoe MDL2 Assets"
                               FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 8 PLOT CELLS (4 Columns x 2 Rows) - Centered 4x2 Block  -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1" x:Name="gridPlotsContainer" Margin="4" SizeChanged="OnPlotsAreaSizeChanged"
              UseLayoutRounding="True" SnapsToDevicePixels="True">
            <Grid x:Name="gridPlotsBlock" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Plot 1 -->
                <Border x:Name="brCell1" Grid.Row="0" Grid.Column="0" Margin="4"
                        BorderBrush="#000000" BorderThickness="1" SnapsToDevicePixels="True" Background="White">
                    <Canvas x:Name="Canvas1" ClipToBounds="True">
                        <Rectangle x:Name="recBg1" Fill="White"/>
                        <Canvas x:Name="cnGrid1"/>
                        <Line x:Name="axisH1"/>
                        <Line x:Name="axisV1"/>
                        <Canvas x:Name="cnBr1">
                            <Canvas x:Name="cnPoints1"/>
                        </Canvas>
                        <TextBlock x:Name="lblFreq1" Canvas.Left="0" Canvas.Top="0" Background="LightBlue" FontWeight="Bold" FontSize="13" Panel.ZIndex="1000" Padding="4,1"/>
                        <Canvas x:Name="canXY1" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1000">
                            <TextBlock x:Name="lblGraphXY1" HorizontalAlignment="Right" Canvas.Right="0" Canvas.Top="0" FontWeight="Bold" FontSize="13" Padding="2,0"/>
                        </Canvas>
                        <Rectangle x:Name="rResult1" Width="20" Height="20" Fill="White" Panel.ZIndex="1000"/>
                        <Border x:Name="btnSetting1" Cursor="Hand" Panel.ZIndex="1000" Width="42" Height="24"
                                Background="#305371" BorderBrush="#000000" BorderThickness="1" CornerRadius="5" Tag="1" MouseDown="OnSettingClick">
                            <Label Foreground="White" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Setting" Padding="0"/>
                        </Border>
                    </Canvas>
                </Border>

                <!-- Plot 2 -->
                <Border x:Name="brCell2" Grid.Row="0" Grid.Column="1" Margin="4"
                        BorderBrush="#000000" BorderThickness="1" SnapsToDevicePixels="True" Background="White">
                    <Canvas x:Name="Canvas2" ClipToBounds="True">
                        <Rectangle x:Name="recBg2" Fill="White"/>
                        <Canvas x:Name="cnGrid2"/>
                        <Line x:Name="axisH2"/>
                        <Line x:Name="axisV2"/>
                        <Canvas x:Name="cnBr2">
                            <Canvas x:Name="cnPoints2"/>
                        </Canvas>
                        <TextBlock x:Name="lblFreq2" Canvas.Left="0" Canvas.Top="0" Background="LightBlue" FontWeight="Bold" FontSize="13" Panel.ZIndex="1000" Padding="4,1"/>
                        <Canvas x:Name="canXY2" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1000">
                            <TextBlock x:Name="lblGraphXY2" HorizontalAlignment="Right" Canvas.Right="0" Canvas.Top="0" FontWeight="Bold" FontSize="13" Padding="2,0"/>
                        </Canvas>
                        <Rectangle x:Name="rResult2" Width="20" Height="20" Fill="White" Panel.ZIndex="1000"/>
                        <Border x:Name="btnSetting2" Cursor="Hand" Panel.ZIndex="1000" Width="42" Height="24"
                                Background="#305371" BorderBrush="#000000" BorderThickness="1" CornerRadius="5" Tag="2" MouseDown="OnSettingClick">
                            <Label Foreground="White" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Setting" Padding="0"/>
                        </Border>
                    </Canvas>
                </Border>

                <!-- Plot 3 -->
                <Border x:Name="brCell3" Grid.Row="0" Grid.Column="2" Margin="4"
                        BorderBrush="#000000" BorderThickness="1" SnapsToDevicePixels="True" Background="White">
                    <Canvas x:Name="Canvas3" ClipToBounds="True">
                        <Rectangle x:Name="recBg3" Fill="White"/>
                        <Canvas x:Name="cnGrid3"/>
                        <Line x:Name="axisH3"/>
                        <Line x:Name="axisV3"/>
                        <Canvas x:Name="cnBr3">
                            <Canvas x:Name="cnPoints3"/>
                        </Canvas>
                        <TextBlock x:Name="lblFreq3" Canvas.Left="0" Canvas.Top="0" Background="LightBlue" FontWeight="Bold" FontSize="13" Panel.ZIndex="1000" Padding="4,1"/>
                        <Canvas x:Name="canXY3" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1000">
                            <TextBlock x:Name="lblGraphXY3" HorizontalAlignment="Right" Canvas.Right="0" Canvas.Top="0" FontWeight="Bold" FontSize="13" Padding="2,0"/>
                        </Canvas>
                        <Rectangle x:Name="rResult3" Width="20" Height="20" Fill="White" Panel.ZIndex="1000"/>
                        <Border x:Name="btnSetting3" Cursor="Hand" Panel.ZIndex="1000" Width="42" Height="24"
                                Background="#305371" BorderBrush="#000000" BorderThickness="1" CornerRadius="5" Tag="3" MouseDown="OnSettingClick">
                            <Label Foreground="White" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Setting" Padding="0"/>
                        </Border>
                    </Canvas>
                </Border>

                <!-- Plot 4 -->
                <Border x:Name="brCell4" Grid.Row="0" Grid.Column="3" Margin="4"
                        BorderBrush="#000000" BorderThickness="1" SnapsToDevicePixels="True" Background="White">
                    <Canvas x:Name="Canvas4" ClipToBounds="True">
                        <Rectangle x:Name="recBg4" Fill="White"/>
                        <Canvas x:Name="cnGrid4"/>
                        <Line x:Name="axisH4"/>
                        <Line x:Name="axisV4"/>
                        <Canvas x:Name="cnBr4">
                            <Canvas x:Name="cnPoints4"/>
                        </Canvas>
                        <TextBlock x:Name="lblFreq4" Canvas.Left="0" Canvas.Top="0" Background="LightBlue" FontWeight="Bold" FontSize="13" Panel.ZIndex="1000" Padding="4,1"/>
                        <Canvas x:Name="canXY4" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1000">
                            <TextBlock x:Name="lblGraphXY4" HorizontalAlignment="Right" Canvas.Right="0" Canvas.Top="0" FontWeight="Bold" FontSize="13" Padding="2,0"/>
                        </Canvas>
                        <Rectangle x:Name="rResult4" Width="20" Height="20" Fill="White" Panel.ZIndex="1000"/>
                        <Border x:Name="btnSetting4" Cursor="Hand" Panel.ZIndex="1000" Width="42" Height="24"
                                Background="#305371" BorderBrush="#000000" BorderThickness="1" CornerRadius="5" Tag="4" MouseDown="OnSettingClick">
                            <Label Foreground="White" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Setting" Padding="0"/>
                        </Border>
                    </Canvas>
                </Border>

                <!-- Plot 5 -->
                <Border x:Name="brCell5" Grid.Row="1" Grid.Column="0" Margin="4"
                        BorderBrush="#000000" BorderThickness="1" SnapsToDevicePixels="True" Background="White">
                    <Canvas x:Name="Canvas5" ClipToBounds="True">
                        <Rectangle x:Name="recBg5" Fill="White"/>
                        <Canvas x:Name="cnGrid5"/>
                        <Line x:Name="axisH5"/>
                        <Line x:Name="axisV5"/>
                        <Canvas x:Name="cnBr5">
                            <Canvas x:Name="cnPoints5"/>
                        </Canvas>
                        <TextBlock x:Name="lblFreq5" Canvas.Left="0" Canvas.Top="0" Background="LightBlue" FontWeight="Bold" FontSize="13" Panel.ZIndex="1000" Padding="4,1"/>
                        <Canvas x:Name="canXY5" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1000">
                            <TextBlock x:Name="lblGraphXY5" HorizontalAlignment="Right" Canvas.Right="0" Canvas.Top="0" FontWeight="Bold" FontSize="13" Padding="2,0"/>
                        </Canvas>
                        <Rectangle x:Name="rResult5" Width="20" Height="20" Fill="White" Panel.ZIndex="1000"/>
                        <Border x:Name="btnSetting5" Cursor="Hand" Panel.ZIndex="1000" Width="42" Height="24"
                                Background="#305371" BorderBrush="#000000" BorderThickness="1" CornerRadius="5" Tag="5" MouseDown="OnSettingClick">
                            <Label Foreground="White" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Setting" Padding="0"/>
                        </Border>
                    </Canvas>
                </Border>

                <!-- Plot 6 -->
                <Border x:Name="brCell6" Grid.Row="1" Grid.Column="1" Margin="4"
                        BorderBrush="#000000" BorderThickness="1" SnapsToDevicePixels="True" Background="White">
                    <Canvas x:Name="Canvas6" ClipToBounds="True">
                        <Rectangle x:Name="recBg6" Fill="White"/>
                        <Canvas x:Name="cnGrid6"/>
                        <Line x:Name="axisH6"/>
                        <Line x:Name="axisV6"/>
                        <Canvas x:Name="cnBr6">
                            <Canvas x:Name="cnPoints6"/>
                        </Canvas>
                        <TextBlock x:Name="lblFreq6" Canvas.Left="0" Canvas.Top="0" Background="LightBlue" FontWeight="Bold" FontSize="13" Panel.ZIndex="1000" Padding="4,1"/>
                        <Canvas x:Name="canXY6" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1000">
                            <TextBlock x:Name="lblGraphXY6" HorizontalAlignment="Right" Canvas.Right="0" Canvas.Top="0" FontWeight="Bold" FontSize="13" Padding="2,0"/>
                        </Canvas>
                        <Rectangle x:Name="rResult6" Width="20" Height="20" Fill="White" Panel.ZIndex="1000"/>
                        <Border x:Name="btnSetting6" Cursor="Hand" Panel.ZIndex="1000" Width="42" Height="24"
                                Background="#305371" BorderBrush="#000000" BorderThickness="1" CornerRadius="5" Tag="6" MouseDown="OnSettingClick">
                            <Label Foreground="White" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Setting" Padding="0"/>
                        </Border>
                    </Canvas>
                </Border>

                <!-- Plot 7 -->
                <Border x:Name="brCell7" Grid.Row="1" Grid.Column="2" Margin="4"
                        BorderBrush="#000000" BorderThickness="1" SnapsToDevicePixels="True" Background="White">
                    <Canvas x:Name="Canvas7" ClipToBounds="True">
                        <Rectangle x:Name="recBg7" Fill="White"/>
                        <Canvas x:Name="cnGrid7"/>
                        <Line x:Name="axisH7"/>
                        <Line x:Name="axisV7"/>
                        <Canvas x:Name="cnBr7">
                            <Canvas x:Name="cnPoints7"/>
                        </Canvas>
                        <TextBlock x:Name="lblFreq7" Canvas.Left="0" Canvas.Top="0" Background="LightBlue" FontWeight="Bold" FontSize="13" Panel.ZIndex="1000" Padding="4,1"/>
                        <Canvas x:Name="canXY7" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1000">
                            <TextBlock x:Name="lblGraphXY7" HorizontalAlignment="Right" Canvas.Right="0" Canvas.Top="0" FontWeight="Bold" FontSize="13" Padding="2,0"/>
                        </Canvas>
                        <Rectangle x:Name="rResult7" Width="20" Height="20" Fill="White" Panel.ZIndex="1000"/>
                        <Border x:Name="btnSetting7" Cursor="Hand" Panel.ZIndex="1000" Width="42" Height="24"
                                Background="#305371" BorderBrush="#000000" BorderThickness="1" CornerRadius="5" Tag="7" MouseDown="OnSettingClick">
                            <Label Foreground="White" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Setting" Padding="0"/>
                        </Border>
                    </Canvas>
                </Border>

                <!-- Plot 8 -->
                <Border x:Name="brCell8" Grid.Row="1" Grid.Column="3" Margin="4"
                        BorderBrush="#000000" BorderThickness="1" SnapsToDevicePixels="True" Background="White">
                    <Canvas x:Name="Canvas8" ClipToBounds="True">
                        <Rectangle x:Name="recBg8" Fill="White"/>
                        <Canvas x:Name="cnGrid8"/>
                        <Line x:Name="axisH8"/>
                        <Line x:Name="axisV8"/>
                        <Canvas x:Name="cnBr8">
                            <Canvas x:Name="cnPoints8"/>
                        </Canvas>
                        <TextBlock x:Name="lblFreq8" Canvas.Left="0" Canvas.Top="0" Background="LightBlue" FontWeight="Bold" FontSize="13" Panel.ZIndex="1000" Padding="4,1"/>
                        <Canvas x:Name="canXY8" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1000">
                            <TextBlock x:Name="lblGraphXY8" HorizontalAlignment="Right" Canvas.Right="0" Canvas.Top="0" FontWeight="Bold" FontSize="13" Padding="2,0"/>
                        </Canvas>
                        <Rectangle x:Name="rResult8" Width="20" Height="20" Fill="White" Panel.ZIndex="1000"/>
                        <Border x:Name="btnSetting8" Cursor="Hand" Panel.ZIndex="1000" Width="42" Height="24"
                                Background="#305371" BorderBrush="#000000" BorderThickness="1" CornerRadius="5" Tag="8" MouseDown="OnSettingClick">
                            <Label Foreground="White" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Setting" Padding="0"/>
                        </Border>
                    </Canvas>
                </Border>
            </Grid>
        </Grid>

        <!-- ======================================================== -->
        <!-- BOTTOM CONTROL BAR (Buttons, Counters, Overall Result) -->
        <!-- ======================================================== -->
        <Grid Grid.Row="2" Margin="2,3,2,3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Action Buttons -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="2" Height="36" Background="#305371" CornerRadius="6" Cursor="Hand" MouseDown="OnBalanceClick">
                    <Label Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Content="Balance"/>
                </Border>
                <Border Grid.Column="1" Margin="2" Height="36" Background="#305371" CornerRadius="6" Cursor="Hand" MouseDown="OnTestClick">
                    <Label Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Content="Test"/>
                </Border>
                <Border Grid.Column="2" Margin="2" Height="36" Background="#305371" CornerRadius="6" Cursor="Hand" MouseDown="OnClearClick">
                    <Label Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Content="Clear"/>
                </Border>
                <Border Grid.Column="3" Margin="2" Height="36" Background="#305371" CornerRadius="6" Cursor="Hand" MouseDown="OnLogClick">
                    <Label Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{Binding LogButtonText, FallbackValue='Start Log'}"/>
                </Border>
                <Border Grid.Column="4" Margin="2" Height="36" Background="#305371" CornerRadius="6" Cursor="Hand" MouseDown="OnResetCountClick">
                    <Label Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Content="Reset Count"/>
                </Border>
            </Grid>

            <!-- Row 1: Counters and Overall Result -->
            <Grid Grid.Row="1" Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="2" Height="32" Background="#424242" CornerRadius="6">
                    <Label Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{Binding TotalCountText, FallbackValue='Total - 0'}"/>
                </Border>
                <Border Grid.Column="1" Margin="2" Height="32" Background="#2E7D32" CornerRadius="6">
                    <Label Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{Binding OkCountText, FallbackValue='OK - 0'}"/>
                </Border>
                <Border Grid.Column="2" Margin="2" Height="32" Background="#C62828" CornerRadius="6">
                    <Label Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{Binding NotOkCountText, FallbackValue='Not OK - 0'}"/>
                </Border>
                <Border Grid.Column="3" Margin="2" Height="32" Background="{Binding OverallResultBrush}" CornerRadius="6">
                    <Label Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Content="Overall Result"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
