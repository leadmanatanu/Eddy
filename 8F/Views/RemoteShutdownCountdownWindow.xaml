<Window x:Class="_8F.Views.RemoteShutdownCountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Shutdown"
        Height="220" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStyle="SingleBorderWindow"
        Background="#2D3037">
    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#D9534F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Machine requested PC shutdown."
                   FontSize="17"
                   FontWeight="Bold"
                   Foreground="#FFFFFF"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <TextBlock x:Name="lblCountdown"
                   Grid.Row="1"
                   Text="Shutting down in 15 seconds"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#FFCC00"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <!--<Button x:Name="btnCancel"
                Grid.Row="2"
                Content="Cancel"
                Width="120"
                Height="36"
                Style="{StaticResource ActionButtonStyle}"
                HorizontalAlignment="Center"
                IsCancel="True"
                Click="BtnCancel_Click"/>-->
    </Grid>
</Window>
