<Window x:Class="_8F.Freq"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_8F"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Window1" 
        ResizeMode="NoResize" Height="520" WindowStartupLocation="CenterScreen"  Width="720"  WindowState="Normal"  WindowStyle="None"
        >
    <Border Name="brRef" Margin="2" Background="#DBDBDB" Grid.Column="1" Grid.Row="2" BorderBrush="#DBDBDB" BorderThickness="5" CornerRadius="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Name="lblTitle" Margin="0,10,0,0" Content="System Configuration" VerticalAlignment="Top" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Grid.Row="0" Grid.Column="0"></Label>
            <Border Width="80" Name="btnClose" Margin="0,15,25,0" MouseDown="Button_Click" Background="#305371" HorizontalAlignment="Right" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                <Label Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Close" ></Label>
            </Border>
            <Separator VerticalAlignment="Top" Grid.Row="1" Grid.Column="0"/>

            <Grid Margin="20,20,20,20" Grid.Row="2" Grid.Column="0">
                <DataGrid Name="gdFreq" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False"
              FontSize="16" SelectionMode="Single" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Freq Channel" Width="*" Binding="{Binding Name}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Frequency" Width="*" Binding="{Binding freq}" />
                        <DataGridTextColumn Header="Gain" Width="*" Binding="{Binding gain}" />
                        <DataGridTextColumn Header="Phase" Width="*" Binding="{Binding phase}" />
                        <DataGridCheckBoxColumn Header="Status" Width="*" Binding="{Binding isEnable}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Grid.Row="3" Margin="20,10,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label x:Name="lblTxStrength"
           Grid.Column="0"
           Content="Tx Strength (%)"
           FontSize="16"
           FontWeight="SemiBold"
           VerticalAlignment="Center"/>

                <xctk:IntegerUpDown
                x:Name="txtTxStrength"
                Grid.Column="1"
                Width="100"
                Height="36"
                FontSize="16"
                Minimum="1"
                Value="100"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"/>

                <TextBlock Grid.Column="2"
               Margin="15,0,0,0"
               VerticalAlignment="Center"
               FontSize="14"
               Foreground="Gray"/>
            </Grid>
            <Border Width="250" Name="btnConfigSave" MouseDown="btnConfigSave_Click" Margin="18" Background="#305371" Grid.Column="0" Grid.Row="4" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                <Label Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Save Config" RenderTransformOrigin="0.575,0.022" ></Label>
            </Border>

            <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" Margin="20,0,20,10">
                <Label Name="lblMsg" Content="" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="Red" FontWeight="SemiBold" HorizontalContentAlignment="Left"/>
            </ScrollViewer>

        </Grid>
    </Border>
</Window>
