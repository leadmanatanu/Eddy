<Window x:Class="_8F.Views.ModbusTestPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Modbus TCP Slave Diagnostic Panel" Height="680" Width="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F4F6F9">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#305371" Padding="12" CornerRadius="6" Margin="0,0,0,12">
            <TextBlock Text="Modbus TCP Slave Diagnostic Panel" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>

        <!-- Server Status -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
            <TextBlock Text="Status: " FontSize="14" FontWeight="SemiBold" Foreground="#333333"/>
            <TextBlock Name="lblStatus" Text="Stopped" FontSize="14" FontWeight="Bold" Foreground="Red"/>
        </StackPanel>

        <!-- Register 0 (Profile ID) Section -->
        <Border Grid.Row="2" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Holding Register 0 (Profile ID / Address 0)" FontSize="12" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBlock Name="lblRegister0Value" Text="0" FontSize="24" FontWeight="Bold" Foreground="#005A9E"/>
                    </StackPanel>
                    <Button Name="btnRefresh0" Grid.Column="1" Content="Refresh" Width="80" Height="32" Click="btnRefresh0_Click" Background="#305371" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Name="txtWriteValue0" Grid.Column="0" Height="32" FontSize="13" Padding="6,4" VerticalContentAlignment="Center" Text="0"/>
                    <Button Name="btnWrite0" Grid.Column="2" Content="Write Reg 0" Width="110" Height="32" Click="btnWrite0_Click" Background="#28A745" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Register 1 (Heartbeat) Section -->
        <Border Grid.Row="3" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Holding Register 1 (Heartbeat / Address 1)" FontSize="12" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBlock Name="lblHeartbeatValue" Text="0" FontSize="24" FontWeight="Bold" Foreground="#D9534F"/>
                    </StackPanel>
                    <Button Name="btnRefresh1" Grid.Column="1" Content="Refresh" Width="80" Height="32" Click="btnRefresh1_Click" Background="#305371" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                </Grid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Name="txtWriteValue1" Grid.Column="0" Height="32" FontSize="13" Padding="6,4" VerticalContentAlignment="Center" Text="0"/>
                    <Button Name="btnWrite1" Grid.Column="2" Content="Write Reg 1" Width="110" Height="32" Click="btnWrite1_Click" Background="#17A2B8" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                </Grid>
                <TextBlock Text="* Manual writes are overwritten by the next automatic tick." FontSize="11" FontStyle="Italic" Foreground="#666666"/>
            </StackPanel>
        </Border>

        <!-- Register 2 (Profile Load Status) Section -->
        <Border Grid.Row="4" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Holding Register 2 (Profile Load Status / Address 2)" FontSize="12" FontWeight="SemiBold" Foreground="#333333"/>
                    <TextBlock Name="lblStatusRegisterValue" Text="0 - Idle" FontSize="20" FontWeight="Bold" Foreground="#6C757D"/>
                </StackPanel>
                <Button Name="btnRefresh2" Grid.Column="1" Content="Refresh" Width="80" Height="32" Click="btnRefresh2_Click" Background="#305371" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Close Button -->
        <Button Name="btnClose" Grid.Row="6" Content="Close" Width="100" Height="34" HorizontalAlignment="Right" Click="btnClose_Click" Background="#6C757D" Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>
    </Grid>
</Window>
