<Window x:Class="_8F.Views.ModbusTestPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Modbus TCP Slave Diagnostic Panel" Height="760" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F4F6F9">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#305371" Padding="12" CornerRadius="6" Margin="0,0,0,12">
            <TextBlock Text="Modbus TCP Slave Diagnostic Panel" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>

        <!-- Server Status -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
            <TextBlock Text="Status: " FontSize="14" FontWeight="SemiBold" Foreground="#333333"/>
            <TextBlock Name="lblStatus" Text="Stopped" FontSize="14" FontWeight="Bold" Foreground="Red"/>
        </StackPanel>

        <!-- Scrollable Register Cards -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel Margin="0,0,8,0">
                <!-- Register 0 (Heartbeat / Address 0) -->
                <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Heartbeat (Address 0)" FontSize="12" FontWeight="SemiBold" Foreground="#333333"/>
                                <TextBlock Name="lblHeartbeatValue" Text="0" FontSize="22" FontWeight="Bold" Foreground="#D9534F"/>
                            </StackPanel>
                            <Button Name="btnRefreshHeartbeat" Grid.Column="1" Content="Refresh" Width="80" Height="30" Click="btnRefreshHeartbeat_Click" Background="#305371" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="txtWriteValueHeartbeat" Grid.Column="0" Height="30" FontSize="13" Padding="6,4" VerticalContentAlignment="Center" Text="0"/>
                            <Button Name="btnWriteHeartbeat" Grid.Column="2" Content="Write Reg 0" Width="100" Height="30" Click="btnWriteHeartbeat_Click" Background="#17A2B8" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                        </Grid>
                        <TextBlock Text="* Overwritten automatically by the next 1000ms tick." FontSize="11" FontStyle="Italic" Foreground="#666666"/>
                    </StackPanel>
                </Border>

                <!-- Channel 1 (Profile ID / Address 1) -->
                <Border x:Name="cardChannel1" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Channel 1 (Profile ID / Address 1)" FontSize="12" FontWeight="SemiBold" Foreground="#333333"/>
                                <TextBlock Name="lblRegister1Value" Text="0" FontSize="22" FontWeight="Bold" Foreground="#005A9E"/>
                            </StackPanel>
                            <Button Name="btnRefresh1" Grid.Column="1" Content="Refresh" Width="80" Height="30" Click="btnRefresh1_Click" Background="#305371" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="txtWriteValue1" Grid.Column="0" Height="30" FontSize="13" Padding="6,4" VerticalContentAlignment="Center" Text="0"/>
                            <Button Name="btnWrite1" Grid.Column="2" Content="Write Ch 1" Width="100" Height="30" Click="btnWrite1_Click" Background="#28A745" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Channel 2 (Profile ID / Address 2) -->
                <Border x:Name="cardChannel2" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Channel 2 (Profile ID / Address 2)" FontSize="12" FontWeight="SemiBold" Foreground="#333333"/>
                                <TextBlock Name="lblRegister2Value" Text="0" FontSize="22" FontWeight="Bold" Foreground="#005A9E"/>
                            </StackPanel>
                            <Button Name="btnRefresh2" Grid.Column="1" Content="Refresh" Width="80" Height="30" Click="btnRefresh2_Click" Background="#305371" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="txtWriteValue2" Grid.Column="0" Height="30" FontSize="13" Padding="6,4" VerticalContentAlignment="Center" Text="0"/>
                            <Button Name="btnWrite2" Grid.Column="2" Content="Write Ch 2" Width="100" Height="30" Click="btnWrite2_Click" Background="#28A745" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Channel 3 (Profile ID / Address 3) -->
                <Border x:Name="cardChannel3" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Channel 3 (Profile ID / Address 3)" FontSize="12" FontWeight="SemiBold" Foreground="#333333"/>
                                <TextBlock Name="lblRegister3Value" Text="0" FontSize="22" FontWeight="Bold" Foreground="#005A9E"/>
                            </StackPanel>
                            <Button Name="btnRefresh3" Grid.Column="1" Content="Refresh" Width="80" Height="30" Click="btnRefresh3_Click" Background="#305371" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="txtWriteValue3" Grid.Column="0" Height="30" FontSize="13" Padding="6,4" VerticalContentAlignment="Center" Text="0"/>
                            <Button Name="btnWrite3" Grid.Column="2" Content="Write Ch 3" Width="100" Height="30" Click="btnWrite3_Click" Background="#28A745" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Channel 4 (Profile ID / Address 4) -->
                <Border x:Name="cardChannel4" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Channel 4 (Profile ID / Address 4)" FontSize="12" FontWeight="SemiBold" Foreground="#333333"/>
                                <TextBlock Name="lblRegister4Value" Text="0" FontSize="22" FontWeight="Bold" Foreground="#005A9E"/>
                            </StackPanel>
                            <Button Name="btnRefresh4" Grid.Column="1" Content="Refresh" Width="80" Height="30" Click="btnRefresh4_Click" Background="#305371" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="txtWriteValue4" Grid.Column="0" Height="30" FontSize="13" Padding="6,4" VerticalContentAlignment="Center" Text="0"/>
                            <Button Name="btnWrite4" Grid.Column="2" Content="Write Ch 4" Width="100" Height="30" Click="btnWrite4_Click" Background="#28A745" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Close Button -->
        <Button Name="btnClose" Grid.Row="3" Content="Close" Width="100" Height="34" HorizontalAlignment="Right" Click="btnClose_Click" Background="#6C757D" Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>
    </Grid>
</Window>
