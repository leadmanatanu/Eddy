<Window x:Class="_8F.Views.LastChangeNoticeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuration Notice" Height="280" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="MagkraftButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#305371"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#FF000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3d688d"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F4F6F9" BorderBrush="#305371" BorderThickness="2" CornerRadius="12" Margin="5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.4" ShadowDepth="4"/>
        </Border.Effect>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#305371" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                <TextBlock Text="Latest Configuration Notice" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Border>

            <!-- Body -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="5">
                <TextBlock Name="txtHeaderLine" Text="Configuration last changed by Admin:" FontWeight="Bold" FontSize="13" Foreground="#222" Margin="0,0,0,6"/>
                <TextBlock Name="txtAreaLine" Text="Area: -" FontSize="12" Foreground="#444" Margin="0,0,0,6"/>
                <Border Background="White" BorderBrush="#CCC" BorderThickness="1" CornerRadius="6" Padding="8" MaxHeight="100">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Name="txtSummary" Text="No configuration changes recorded." FontSize="12" Foreground="#111" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- OK Button -->
            <Button Grid.Row="2" Content="OK" Style="{StaticResource MagkraftButtonStyle}" Width="100" Height="32" HorizontalAlignment="Center" Margin="0,10,0,0" Click="btnOK_Click" IsDefault="True"/>
        </Grid>
    </Border>
</Window>
