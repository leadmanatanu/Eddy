<Window x:Class="_8F.CircleSetting"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_8F"
        mc:Ignorable="d"
        Title="Circle Setting" 
        ResizeMode="CanResize" Height="450" WindowStartupLocation="CenterScreen" Closing="Window_Closing"  Width="600"  WindowState="Normal" WindowStyle="None">
    
    <Border Name="brRef" Margin="3" Background="#DBDBDB" Grid.Column="1" Grid.Row="2" BorderBrush="#DBDBDB" BorderThickness="1" CornerRadius="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.45*"/>
                <RowDefinition Height="0.45*"/>
                <RowDefinition Height="0.04*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="0.04*"/>
                <RowDefinition Height="0.5*"/>
                <RowDefinition Height="0.3*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Name="lblTitle" Margin="0,10,0,0"  Content="System Configuration" VerticalAlignment="Top" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Grid.Row="0" Grid.Column="0"></Label>

            <Border Width="80" Name="btnClose" Margin="0,15,25,0" MouseDown="Button_Click" Background="#305371" HorizontalAlignment="Right" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                <Label Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Close" ></Label>
            </Border>
            <Separator VerticalAlignment="Top" Grid.Row="1" Grid.Column="0"/>

            <Grid  Grid.Row="3" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Margin="6,-36,6,30"  BorderThickness="1" CornerRadius="10">
                    <DataGrid ItemsSource="{Binding ellipses}"
                  SelectionMode="Single"
                  CanUserSortColumns="False"
                  CanUserAddRows="False"
                  AutoGenerateColumns="False"
                  Name="gdFreq"
                  FontSize="16"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Top"
                  Margin="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" Header="Channel" Binding="{Binding ChannelName}" />
                            <DataGridTextColumn Width="*" Header = "Height" Binding = "{Binding height}" />
                            <DataGridTextColumn Width="*" Header = "Width" Binding = "{Binding width}"/>
                            <DataGridTextColumn Width="*" Header="X" Binding="{Binding ex, StringFormat={}{0:0}}"/>
                            <DataGridTextColumn Width="*" Header="Y" Binding="{Binding ey, StringFormat={}{0:0}}"/>
                            <DataGridTextColumn Width="*" Header = "Angle" Binding = "{Binding angel}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
            <Separator VerticalAlignment="Top" Grid.Row="4" Grid.Column="0"/>

            <Border Width="250" Name="btnConfigSave" MouseDown="btnConfigSave_Click" Margin="1" Background="#305371" Grid.Column="0" Grid.Row="5" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                <Label Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Save Config" ></Label>
            </Border>

            <Label Content="" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Top" Name="lblMsg" Grid.Row="6" Grid.Column="0"></Label>

        </Grid>
    </Border>
</Window>
