<Window x:Class="_8F.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_8F"
        xmlns:vm="clr-namespace:_8F.ViewModels"
        xmlns:views="clr-namespace:_8F.Views"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowState="Maximized" ResizeMode="NoResize" Closed="Window_Closed" KeyDown="Window_KeyDown"
        >

    <Grid Background="Black" Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Name="menuHeight" Height=".5*"/>
            <!--change it from backend-->
            <RowDefinition Name="chennelHeight" Height=".7*"/>
            <!--change it from backend-->
            <RowDefinition Height="7*"/>
            <RowDefinition Name="buttonBarHeight" Height="0*"/>
            <!--change it from backend-->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Background="LightGray"   Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="9*"/>
                <ColumnDefinition Name="LogoWidth" Width="0.1*"/>
                <ColumnDefinition  Width="6*"/>
            </Grid.ColumnDefinitions>
            <Menu Background="LightGray"  VerticalAlignment="Center" Height="30" FontSize="18" Grid.Row="0" Grid.Column="0" DockPanel.Dock="Top" ItemsSource="{Binding MenuItems}">
                <Menu.ItemContainerStyle>
                    <Style TargetType="{x:Type MenuItem}">
                        <Setter Property="Command" Value="{Binding Command}" />
                    </Style>
                </Menu.ItemContainerStyle>
                <Menu.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:MenuItemViewModel}" ItemsSource="{Binding Path=MenuItems}">
                        <TextBlock Text="{Binding Header}"/>
                    </HierarchicalDataTemplate>
                </Menu.ItemTemplate>
            </Menu>

            <Image Name="imgLogo" Visibility="Hidden"  Width="180" Panel.ZIndex="999" Grid.Row="0" Grid.Column="1" />
            <Label Name="lblCode" Content="" VerticalAlignment="Center" HorizontalAlignment="right" FontSize="16" Foreground="red" FontWeight="Bold" Grid.Row="0" Grid.Column="2"></Label>
        </Grid>


        <Grid Grid.Column="0" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width=".1*"/>
                <ColumnDefinition Width=".12*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Grid.Row="0" x:Name="gridTabs">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Border Cursor="Hand" Name="btnCh1"  Tag="1" MouseDown="btnCh_Click" Margin="3" Background="#305371" Grid.Column="0" Grid.Row="0" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                    <Label Foreground="Black" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Channel-1" ></Label>
                </Border>

                <Border Cursor="Hand" Name="btnCh2"  Tag="2" MouseDown="btnCh_Click" Margin="3" Background="#305371" Grid.Column="1" Grid.Row="0" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                    <Label Foreground="Black" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Channel-2" ></Label>
                </Border>

                <Border Cursor="Hand" Name="btnCh3"  Tag="3" MouseDown="btnCh_Click" Margin="3" Background="#305371" Grid.Column="2" Grid.Row="0" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
                    <Label Foreground="Black" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Channel-3" ></Label>
                </Border>

                <Border Cursor="Hand" Name="btnCh4"  Tag="4" MouseDown="btnCh_Click" Margin="3" Background="#305371" Grid.Column="3" Grid.Row="0" BorderBrush="#FF000000" BorderThickness=".5" CornerRadius="10">
