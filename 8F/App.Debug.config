<?xml version="1.0" encoding="utf-8" ?>
<!-- DEBUG-ONLY CONFIGURATION: Never included in Release builds or published installers -->
<configuration>
	<appSettings>
		<add key="FrequencyNo" value="8" />

		<!-- File Menu Toggles -->
		<add key="IsOpenWithDb" value="true" />                      
		<add key="IsOpenWithFile" value="false" />                   
		<add key="IsSaveWithDb" value="true" />                      
		<add key="IsSaveWithFile" value="false" />                   
		<add key="IsSaveAsWithDb" value="true" />                    
		<add key="IsSaveAsWithFile" value="false" />                 
		<add key="IsImportConfigurationWithDb" value="true" />      
		<add key="IsImportConfigurationWithFile" value="false" />     
		<add key="IsExportConfigurationWithDb" value="false" />       
		<add key="IsExportConfigurationWithFile" value="false" />    
		<add key="IsExitEnable" value="true" />                      

		<!-- Modbus TCP Slave Toggles -->
		<add key="IsModbusServerEnable" value="true" />
		<add key="ModbusServerPort" value="5020" />
		<add key="ModbusHeartbeatIntervalMs" value="1000" />

		<!-- Configuration Menu Toggles -->
		<add key="IsPasswordEnable" value="false" />
		<add key="IsChangeConfigurationEnable" value="true" /> 
		<add key="IsThresholdSettingEnable" value="true" />    
		<add key="IsAutoEllipseEnable" value="true" />         
		<add key="IsReNewConfig" value="true" />               
		<add key="IsWriteConfigurationEnable" value="true" />  
		<add key="IsCopyChannel1ConfigurationEnable" value="true" />
		<add key="IsChangePasswordEnable" value="true" />     

		<!-- View Log Menu Toggles -->
		<add key="IsBatchWiseLogEnable" value="true" />   
		<add key="IsSerialNumberLogEnable" value="true" />
		<add key="IsPdfReportEnable" value="true" />      

		<!-- Counter Visibility Toggles -->
		<add key="IsTotalCountVisible" value="false" />
		<add key="IsOkCountVisible" value="true" />   
		<add key="IsNotOkCountVisible" value="false" />

		<!-- Hardware & System Flags -->
		<add key="IsLogRequiredOnBalance" value="true" />
		<add key="IsTxStrengthEnable" value="true" />
		<add key="IsTestLogOff" value="true" />
	</appSettings>
</configuration>
